# Set these locally (do NOT commit real keys)
STRIPE_SECRET_KEY=sk_test_xxx
# Optional: for webhook verification
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Server-side Price ID mapping (optional but recommended for production)
# Create price IDs in the Stripe Dashboard (Products → Price) and set them here as JSON.
# Example (single-line JSON):
# PRICE_MAP_JSON='{"demo-1":"price_1NExa2Abc...","demo-2":"price_1NEyB3Xyz..."}'
PRICE_MAP_JSON=

# Currency and redirect URLs
CURRENCY=eur
SUCCESS_URL=http://localhost:5173/checkout-success?session_id={CHECKOUT_SESSION_ID}
CANCEL_URL=http://localhost:5173/cart
PORT=4242
