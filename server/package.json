{
  "name": "optixtweak-server",
  "version": "1.0.0",
  "description": "Express backend scaffold for OptixTweak demo (Stripe checkout, webhooks, licenses, PR automation)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "clean-data": "node -e \"require('fs').writeFileSync('data/licenses.json','[]')\"",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^5.19.0",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.18.2",
    "pg": "^8.12.0",
    "stripe": "^12.0.0"
  },
  "devDependencies": {
    "@octokit/rest": "^20.0.2",
    "nodemon": "^2.0.22",
    "prisma": "^5.19.0"
  }
}

